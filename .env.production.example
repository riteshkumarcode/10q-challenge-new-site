# ==============================================================================
# 10Q Challenge Platform - Production Environment Variables
# Copy this file to .env.production or enter these keys into Hostinger hPanel
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3000

# Canonical Site URL (Used for SEO, Metadata, Sitemap, Canonical tags)
NEXT_PUBLIC_SITE_URL=https://10qchallenge.in

# Backend API Endpoint
NEXT_PUBLIC_API_URL=https://10qchallenge.in/api

# PayU Payment Gateway Credentials
NEXT_PUBLIC_PAYU_KEY=YourPayUMerchantKeyHere
PAYU_MERCHANT_KEY=YourPayUMerchantKeyHere
PAYU_MERCHANT_SALT=YourPayUMerchantSaltHere

# JWT Authentication Secret (for Next.js / API Auth)
JWT_SECRET=10QChallenge_SecureKey_SuperSecret_2025_Min256BitsLong!

# Database Connection (If connecting directly from API/Node)
# DB_SERVER=localhost
# DB_NAME=10QChallengeDb
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
